# Copy to client/.env and edit. All three are optional.

# Where the Vite dev proxy forwards /api. The proxy runs on this machine, so
# keep it on loopback even when other devices browse the app.
VITE_API_TARGET=http://127.0.0.1:3000

# Expose the Vite dev server on the network (phone / another PC on the LAN).
# Unset = localhost only. The API also needs HOST=0.0.0.0 only if something
# other than the proxy talks to it directly.
# VITE_DEV_HOST=0.0.0.0

# Make the browser call the API origin directly instead of going through the
# proxy. Leave unset for the normal same-origin setup.
# VITE_API_BASE=http://localhost:3000
