# Copy to server/.env and edit. Every value below is already the default, so an
# untouched copy changes nothing. Loaded by `--env-file-if-exists=.env` in the
# npm scripts (Node's built-in .env support — no dotenv package involved).
#
# NOTE: the file is only read at process start. Restart the server after editing.

# API listener. 0.0.0.0 binds every interface — LAN address AND loopback.
# Do NOT pin a single LAN IP here: that excludes 127.0.0.1, which is exactly what
# the Vite dev proxy targets, so the whole client starts returning 500.
PORT=3000
HOST=0.0.0.0

# Upload ceiling in bytes (100 MB).
MAX_UPLOAD_BYTES=104857600

# Session cache: idle lifetime of a parsed document, sweep interval, and how many
# documents may be held at once (oldest evicted first).
DOC_TTL_MS=3600000
DOC_SWEEP_MS=300000
DOC_MAX=12

# Cap on returned coordinates per search. Counts stay exact past this limit;
# only the results[] array is truncated (the response sets truncated: true).
SEARCH_MAX_RESULTS=5000

# --- Save as PDF: destination folders -------------------------------------
# The browser can only open the real Windows Save As dialog in a secure
# context (https, or http://localhost). Over plain http on a LAN address the
# app falls back to an in-app folder browser and the SERVER writes the file.
#
# By default that browser can reach anywhere the server user can — drives,
# Desktop, Documents — so it behaves like a normal Save As. Set EXPORT_ROOT to
# confine it to one tree. Worth doing if the API is reachable from the network:
# anyone who can reach /api can otherwise browse folder names and drop PDFs
# anywhere this account can write.
# EXPORT_ROOT=C:\\Users\\ihs111\\Documents

# Disable the server-side save entirely (the browser download still works).
# EXPORT_ENABLED=false
