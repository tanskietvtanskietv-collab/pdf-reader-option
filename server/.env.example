# Copy to server/.env and edit. Every value below is already the default, so an
# untouched copy changes nothing. Loaded by `--env-file-if-exists=.env` in the
# npm scripts (Node's built-in .env support — no dotenv package involved).
#
# NOTE: the file is only read at process start. Restart the server after editing.

# API listener. 0.0.0.0 accepts LAN connections; use 127.0.0.1 for localhost only.
PORT=3000
HOST=0.0.0.0

# Upload ceiling in bytes (100 MB).
MAX_UPLOAD_BYTES=104857600

# Session cache: idle lifetime of a parsed document, sweep interval, and how many
# documents may be held at once (oldest evicted first).
DOC_TTL_MS=3600000
DOC_SWEEP_MS=300000
DOC_MAX=12

# Cap on returned coordinates per search. Counts stay exact past this limit;
# only the results[] array is truncated (the response sets truncated: true).
SEARCH_MAX_RESULTS=5000
